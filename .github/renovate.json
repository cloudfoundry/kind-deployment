{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^versions.yaml$/",
        "/^Makefile$/",
        "/^\\.github/workflows/.+\\.yaml$/",
        "/^scripts/tools.sh$/"
      ],
      "matchStrings": [
        "# renovate: dataSource=(?<datasource>.*?) depName=(?<depName>.*?)( packageName=(?<packageName>.*?))?\\s+\\S+?(: | = | \\?= )\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?",
        "# renovate: dataSource=(?<datasource>.*?) depName=(?<depName>.*?)\\sexport .*?_VERSION=\"(?<currentValue>.*)\""
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "helm-values": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}