---
helmDefaults:
  wait: true
  timeout: 1200
  recreatePods: false
  force: false
  createNamespace: true
  syncArgs:
    - --hide-notes

environments:
  default:
    values:
      - ./values.yaml.gotmpl
      - ./versions.yaml
      {{- range (env "ADDITIONAL_VALUES_FILES" | default "" | splitList ",") }}
      {{- if . }}
      - {{ . | trim }}
      {{- end }}
      {{- end }}
---
repositories:
  - name: nats
    url: https://nats-io.github.io/k8s/helm/charts
  - name: istio
    url: https://istio-release.storage.googleapis.com/charts
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: cilium
    url: https://helm.cilium.io/
  - name: cloudfoundry-k8s
    oci: true
    url: ghcr.io/cloudfoundry/helm
  - name: projectcalico
    url: https://docs.tigera.io/calico/charts

{{- $cniReleaseNamespace := "kube-system" }}
{{- $cniChart := .Values.charts.cilium.url }}
{{- $cniVersion := .Values.charts.cilium.version }}

{{- if eq .Values.cni "calico" }}
{{- $cniReleaseNamespace = "tigera-operator" }}
{{- $cniChart = .Values.charts.calico.url }}
{{- $cniVersion = .Values.charts.calico.version }}
{{- end }}

{{- $cniRelease := printf "%s/%s" $cniReleaseNamespace .Values.cni }}

releases:
  {{- if .Values.localDeployment }}
  - name: {{ .Values.cni }}
    namespace: {{ $cniReleaseNamespace }}
    chart: {{ $cniChart }}
    version: {{ $cniVersion }}
    values:
      {{- if eq .Values.cni "cilium" }}
      - ./assets/values/cilium.yaml
      {{- else }}
      - ./assets/values/calico.yaml
      {{- end }}
    hooks:
      {{- if eq .Values.cni "calico" }}
      - events: ["presync"]
        showlogs: true
        command: "/bin/sh"
        args:
          - "-c"
          - |
            helm template calico-crds projectcalico/crd.projectcalico.org.v1 --version {{ $cniVersion }} | kubectl apply --server-side -f -
      {{- end }}
      - events: ["postsync"]
        showlogs: true
        command: "/bin/sh"
        args:
          - "-c"
          - |
            echo "Waiting for nodes to become ready after CNI installation..."
            kubectl wait --for=condition=Ready nodes --all --timeout=300s

            corefile=$(kubectl -n kube-system get configmap coredns -o jsonpath='{.data.Corefile}' | sed '/kubernetes/i \
              rewrite name regex (.*)\\.127-0-0-1\\.nip\\.io istio-gateway-istio.{{ .Values.systemNamespace }}.svc.cluster.local answer auto\
            ')
            kubectl -n kube-system patch configmap coredns --type=json \
              -p="$(jq -n --arg cf "$corefile" '[{"op":"replace","path":"/data/Corefile","value":$cf}]')"
            kubectl -n kube-system rollout restart deployment/coredns
  {{- end }}

  - name: istio-base
    namespace: istio-system
    chart: {{ .Values.charts.istioBase.url }}
    version: {{ .Values.charts.istioBase.version }}
    needs:
      {{- if .Values.localDeployment }}
      - {{ $cniRelease }}
      {{- end }}
    values:
      - defaultRevision: minimal

  - name: istiod
    namespace: istio-system
    chart: {{ .Values.charts.istiod.url }}
    version: {{ .Values.charts.istiod.version }}
    needs:
      - istio-base
    values:
      - ./assets/values/istiod.yaml
    hooks:
      - events: ["presync"]
        showlogs: true
        command: "/bin/sh"
        args:
          - "-c"
          - |
            kubectl delete validatingwebhookconfiguration istio-validator-istio-system --ignore-not-found=true
  
  - name: base
    namespace: {{ .Values.systemNamespace }}
    chart: ./assets/base-chart
    needs:
      - istio-system/istiod
    values:
      - cni: {{ .Values.cni }}
        systemDomain: {{ .Values.systemDomain }}
        appsDomain: {{ .Values.appsDomain }}
        gateway:
          infrastructure:
            {{- toYaml .Values.gateway.infrastructure | nindent 12 }}
    set:
      - name: caCert
        file: {{ .Values.certsDir }}/ca.crt
      - name: caKey
        file: {{ .Values.certsDir }}/ca.key
      - name: tlsCert
        file: {{ .Values.certsDir }}/all-in-one.crt
      - name: tlsKey
        file: {{ .Values.certsDir }}/all-in-one.key
    hooks:
      - events: ["presync"]
        showlogs: true
        command: "/bin/sh"
        args:
          - "-c"
          - |
            kubectl apply --server-side --filename assets/gateway-api.yaml

  - name: nats
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.nats.url }}
    version: {{ .Values.charts.nats.version }}
    needs:
      - "{{ .Values.systemNamespace }}/base"
    values:
      - ./assets/values/nats.yaml

  - name: postgresql
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.postgres.url }}
    version: {{ .Values.charts.postgres.version }}
    needs:
      - "{{ .Values.systemNamespace }}/base"
    values:
      - ./assets/values/postgresql.yaml
      - auth:
          password: {{ .Values.secrets.dbPassword }}
      - {{- toYaml .Values.postgresql | nindent 8 }}

  - name: minio
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.minio.url }}
    version: {{ .Values.charts.minio.version }}
    needs:
      - "{{ .Values.systemNamespace }}/base"
    values:
      - extraEnvVars:
          - name: MINIO_DOMAIN
            value: blobstore.{{ .Values.systemDomain }}
        console:
          enabled: false
        resourcesPreset: small
        auth:
          rootPassword: {{ .Values.secrets.blobstorePassword }}
        image:
          repository: bitnamilegacy/minio
        global:
          security:
            allowInsecureImages: true
        persistence:
          enabled: true
          size: 10Gi
          # Ensure blobstore data survives MinIO pod restarts.
          # Without persistence, resource pool SHA1 entries in PostgreSQL become stale:
          # CC says "I have click.tar.gz" -> client skips upload -> MinIO has no file ->
          # package assembly fails -> vendor/click not found in staging container.

  - name: loggregator-agent
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.loggregatorAgent.url }}
    version: {{ .Values.charts.loggregatorAgent.version }}
    needs:
      - {{ .Values.systemNamespace }}/base
    values:
      - syslogBindingCache:
          enabled: true
          certificateSecret: all-in-one-tls
        forwarderAgent:
          enabled: true
          certificateSecret: all-in-one-tls
        loggregatorAgent:
          certificateSecret: all-in-one-tls
        syslogAgent:
          certificateSecret: all-in-one-tls

  - name: gorouter
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.routing.url }}
    version: {{ .Values.charts.routing.version }}
    needs:
      - {{ .Values.systemNamespace }}/base
      - {{ .Values.systemNamespace }}/nats
    values:
      - gorouter:
          enabled: true
          certificateSecret: all-in-one-tls
        udpForwarder:
          certificateSecret: all-in-one-tls

  - name: tcp-routing
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.routing.url }}
    version: {{ .Values.charts.routing.version }}
    installed: {{ .Values.installOptionalComponents }}
    needs:
      - loggregator-agent
      - locket
      - uaa
      - postgresql
    values:
      - routingApi:
          enabled: true
          sqldb:
            password: {{ .Values.secrets.dbPassword }}
            caCertificateSecret: all-in-one-tls
            skipSSLVerify: false
          certificateSecret: all-in-one-tls
          locketCertificateSecret: all-in-one-tls
          uaaCertificateSecret: all-in-one-tls
          systemDomain: {{ .Values.systemDomain }}
        tcpRouter:
          enabled: true
          oauthClientsSecret: {{ .Values.secrets.oauthClientsSecret }}
          certificateSecret: all-in-one-tls

  - name: loggregator
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.loggregator.url }}
    version: {{ .Values.charts.loggregator.version }}
    installed: {{ .Values.installOptionalComponents }}
    needs:
      - {{ .Values.systemNamespace }}/base
    values:
      - systemDomain: {{ .Values.systemDomain }}
        loggregator:
          enabled: true
        doppler:
          certificateSecret: all-in-one-tls
        reverseLogProxy:
          certificateSecret: all-in-one-tls
        reverseLogProxyGateway:
          certificateSecrets:
            httpTLS: all-in-one-tls
            logsProvider: all-in-one-tls
            cc: all-in-one-tls
            uaaCA: all-in-one-tls
            metrics: all-in-one-tls
          uaa:
            clientId: doppler
            clientSecret: {{ .Values.secrets.oauthClientsSecret }}
          logsProvider:
            commonName: reverse-log-proxy
        trafficcontroller:
          certificateSecrets:
            routerTLS: all-in-one-tls
            cc: all-in-one-tls
            outgoing: all-in-one-tls
            uaaCA: all-in-one-tls
          skipCertVerify: true
          uaa:
            clientSecret: {{ .Values.secrets.oauthClientsSecret }}
        routeRegistrar:
          certificateSecret: all-in-one-tls

  - name: log-cache
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.logCache.url }}
    version: {{ .Values.charts.logCache.version }}
    needs:
      - "{{ .Values.systemNamespace }}/base"
      - uaa
    values:
      - logCacheApi:
          certificateSecrets:
            logcacheTLS: all-in-one-tls
            gatewayProxy: all-in-one-tls
            external: all-in-one-tls
            proxyCA: all-in-one-tls
            ccCA: all-in-one-tls
            uaaCA: all-in-one-tls
            metrics: all-in-one-tls
        routeRegistrar:
          certificateSecret: all-in-one-tls
        logCacheBackend:
          systemDomain: {{ .Values.systemDomain }}
          certificateSecrets:
            logcacheTLS: all-in-one-tls
            metrics: all-in-one-tls

  - name: uaa
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.uaa.url }}
    version: {{ .Values.charts.uaa.version }}
    needs:
      - postgresql
      - {{ .Values.systemNamespace }}/base
    values:
      - systemDomain: {{ .Values.systemDomain }}
        uaadb:
          password: {{ .Values.secrets.dbPassword }}
          tls: enabled_skip_hostname_validation
          caCertificateSecret: all-in-one-tls
        certificateSecrets:
          serverTLS: all-in-one-tls
        routeRegistrar:
          certificateSecret: all-in-one-tls
        uaa:
          admin:
            clientSecret: {{ .Values.secrets.uaaAdminSecret | quote }}
          clients:
            cc_routing:
              authorities: routing.router_groups.read
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            cc-service-dashboards:
              authorities: clients.read,clients.write,clients.admin
              authorized-grant-types: client_credentials
              scopes:
                - openid
                - cloud_controller_service_permissions.read
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            cc_service_key_client:
              authorities: credhub.read,credhub.write
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            cf:
              authorities: uaa.none
              authorized-grant-types: password,refresh_token,urn:ietf:params:oauth:grant-type:jwt-bearer
              scopes:
                - network.admin
                - network.write
                - cloud_controller.read
                - cloud_controller.write
                - openid
                - password.write
                - cloud_controller.admin
                - scim.read
                - scim.write
                - doppler.firehose
                - uaa.user
                - routing.router_groups.read
                - routing.router_groups.write
                - cloud_controller.admin_read_only
                - cloud_controller.global_auditor
                - perm.admin
                - clients.read
              override: true
              access-token-validity: 1200
              refresh-token-validity: 2592000
              secret: ""
            cf_smoke_tests:
              authorities: cloud_controller.admin,clients.read
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            cloud_controller_username_lookup:
              authorities: scim.userids,scim.read
              authorized-grant-types: client_credentials
              override: true
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            credhub_admin_client:
              authorities: credhub.read,credhub.write
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            doppler:
              authorities: uaa.resource
              authorized-grant-types: client_credentials
              override: true
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            gorouter:
              authorities: routing.routes.read
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            ssh-proxy:
              authorized-grant-types: authorization_code
              scopes:
                - openid
                - cloud_controller.read
                - cloud_controller.write
                - cloud_controller.admin
              autoapprove: true
              redirect-uri: https://uaa.{{ .Values.systemDomain }}/login
              override: true
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            routing_api_client:
              authorities: routing.routes.write,routing.routes.read,routing.router_groups.read
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            network-policy:
              authorities: uaa.resource,cloud_controller.admin_read_only
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            tcp_emitter:
              authorities: routing.routes.write,routing.routes.read
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            tcp_router:
              authorities: routing.routes.read,routing.router_groups.read
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
            nfsbroker-credhub-client:
              authorities: credhub.read,credhub.write
              authorized-grant-types: client_credentials
              secret: {{ .Values.secrets.oauthClientsSecret | quote }}
          scim:
            users:
              - name: ccadmin
                password: {{ .Values.secrets.ccAdminPassword | quote }}
                email: ccadmin
                firstName: ""
                lastName: ""
                origin: uaa
                groups:
                  - clients.read
                  - cloud_controller.admin
                  - doppler.firehose
                  - network.admin
                  - openid
                  - routing.router_groups.read
                  - routing.router_groups.write
                  - scim.read
                  - scim.write
          jwt:
            policy:
              activeKeyId: key-1
              keys:
                key-1:
                  signingAlg: RS256
        login:
          saml:
            activeKeyId: key-1
            keys:
              key-1:
                passphrase: ""
        encryption:
          activeKeyLabel: default_key
          encryptionKeys:
            - label: default_key
              passphrase: {{ .Values.secrets.uaaEncryptionKey }}
    set:
      - name: uaa.jwt.policy.keys.key-1.signingKey
        file: {{ .Values.certsDir }}/uaa-jwt-signing.key
      - name: login.saml.keys.key-1.key
        file: {{ .Values.certsDir }}/uaa-saml.key
      - name: login.saml.keys.key-1.certificate
        file: {{ .Values.certsDir }}/uaa-saml.crt

  - name: credhub
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.credhub.url }}
    version: {{ .Values.charts.credhub.version }}
    installed: {{ .Values.installOptionalComponents }}
    needs:
      - uaa
      - postgresql
    values:
      - caCertificateSecret: instance-identity
        db:
          password: {{ .Values.secrets.dbPassword }}
          caCertificateSecret: all-in-one-tls
          skipSSLVerify: false

  - name: locket
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.diego.url }}
    version: {{ .Values.charts.diego.version }}
    needs:
      - loggregator-agent
      - postgresql
    values:
      - locketdb:
          password: {{ .Values.secrets.dbPassword }}
          caCertificateSecret: all-in-one-tls
          skipSSLVerify: false
        locket:
          enabled: true
          certificateSecret: all-in-one-tls

  - name: diego
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.diego.url }}
    version: {{ .Values.charts.diego.version }}
    needs:
      - locket
      - uaa
      - loggregator-agent
    set:
      - name: sshProxyHostKey
        file: {{ .Values.certsDir }}/ssh_key
    values:
      - diegodb:
          password: {{ .Values.secrets.dbPassword }}
          caCertificateSecret: all-in-one-tls
          skipSSLVerify: false
        diegoSSHCredentials: {{ .Values.secrets.diegoSSHCredentials }}
        auctioneer:
          enabled: true
          certificateSecret: all-in-one-tls
        bbs:
          enabled: true
          certificateSecret: all-in-one-tls
        fileserver:
          enabled: true
        sshProxy:
          enabled: true
          certificateSecret: all-in-one-tls
          oauthClientsSecret: {{ .Values.secrets.oauthClientsSecret }}
        gatewayObjects:
          enabled: false

  - name: tps-watcher
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.capi.url }}
    version: {{ .Values.charts.capi.version }}
    needs:
      - capi
    values:
      - tpsWatcher:
          enabled: true
          certificateSecrets:
            bbs: all-in-one-tls
            cc: all-in-one-tls
        oauthClientsSecret: ""

  - name: route-emitter
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.diego.url }}
    version: {{ .Values.charts.diego.version }}
    needs:
      - diego
      - nats
    {{ if .Values.installOptionalComponents }}
      - cf-networking
    {{ end }}
    values:
      - diegoSSHCredentials: ""
        sshProxyHostKey: ""
        routeEmitter:
          enabled: true
          certificateSecret: all-in-one-tls
          routingApi:
            enabled: {{ .Values.installOptionalComponents }}
            certificateSecret: all-in-one-tls
          oauthClientsSecret: {{ .Values.secrets.oauthClientsSecret }}
          natsCertificateSecret: all-in-one-tls
          loggregatorCertificateSecret: all-in-one-tls
          bbsCertificateSecret: all-in-one-tls
          locketCertificateSecret: all-in-one-tls
          uaaCertificateSecret: all-in-one-tls
          enableInternalEmitter: {{ .Values.installOptionalComponents }}
          enableTcpEmitter: {{ .Values.installOptionalComponents }}

  - name: rep
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.diego.url }}
    version: {{ .Values.charts.diego.version }}
    needs:
      - diego
    set:
      - name: rep.caCertificate
        file: {{ .Values.certsDir }}/ca.crt
    values:
      - rep:
          enabled: true
          workloadsNamespace: {{ .Values.workloadsNamespace }}
          containerProxyVerifySubjectAltName:
            - gorouter
            - ssh-proxy
            - cf-tcp-router
          loggregator:
            certificateSecret: all-in-one-tls
          locket:
            certificateSecret: all-in-one-tls
          stacks:
          {{- range $stackName, $stackConfig := .Values.stacks }}
            {{- if kindIs "map" $stackConfig }}
            {{ $stackName }}: "{{ $stackConfig.image }}:{{ $stackConfig.tag }}"
            {{- end }}
          {{- end }}

    hooks:
      - events: ["presync"]
        showlogs: true
        command: "/bin/sh"
        args:
          - "-c"
          - |
            kubectl create namespace {{ .Values.workloadsNamespace }} --dry-run=client -o yaml | kubectl apply -f -
            kubectl create configmap trusted-system-certs --namespace {{ .Values.workloadsNamespace }} --from-file=trusted-ca-1.crt={{ .Values.certsDir }}/ca.crt --dry-run=client -o yaml | kubectl apply -f -

  - name: capi
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.capi.url }}
    version: {{ .Values.charts.capi.version }}
    timeout: 1200
    needs:
      - minio
      - diego
      - postgresql
    values:
      - cloudController:
          enabled: true
          certificateSecrets:
            mutualTLS: all-in-one-tls
            loggregatorTLS: all-in-one-tls
            logcacheTLS: all-in-one-tls
            uaaCA: all-in-one-tls
            credhubCA: all-in-one-tls
            publicTLS: all-in-one-tls
          config:
            systemDomain: {{ .Values.systemDomain }}
            appDomains:
              - {{ .Values.appsDomain }}
              - name: apps.internal
                internal: true
            stagingUploadUser: cc-staging
            stagingUploadPassword: cc-staging-dev
            dbEncryptionKey: cc-db-encryption-dev-key
            enableStatsdMetrics: false
            volumeServicesEnabled: true
            temporaryEnableV2: true
            ssl:
              skipCertVerify: true
            routingApi:
              enabled: true
            router:
              routeServicesSecret: route-services-dev-secret
            securityGroups:
              enableCommaDelimitedDestinations: true
            appSsh:
              hostKeyFingerprint: {{ .Values.secrets.sshProxyKeyFingerprint | quote }}
            stacks:
              - description: Cloud Foundry Linux-based filesystem (Ubuntu 22.04)
                name: cflinuxfs4
              - description: Cloud Foundry Linux-based filesystem (Ubuntu 24.04)
                name: cflinuxfs5
            defaultStack: {{ .Values.stacks.default }}
            diego:
              dockerStagingStack: {{ .Values.stacks.default }}
              lifecycleBundles:
                buildpack/cflinuxfs4: buildpack_app_lifecycle/buildpack_app_lifecycle.tgz
                cnb/cflinuxfs4: cnb_app_lifecycle/cnb_app_lifecycle.tgz
                buildpack/cflinuxfs5: buildpack_app_lifecycle/buildpack_app_lifecycle.tgz
                cnb/cflinuxfs5: cnb_app_lifecycle/cnb_app_lifecycle.tgz
                docker: docker_app_lifecycle/docker_app_lifecycle.tgz
              dropletDestinations:
                cflinuxfs4: /home/vcap
                cflinuxfs5: /home/vcap
            droplets:
              connectionConfig:
                awsSecretAccessKey: {{ .Values.secrets.blobstorePassword }}
            packages:
              connectionConfig:
                awsSecretAccessKey: {{ .Values.secrets.blobstorePassword }}
            buildpacks:
              connectionConfig:
                awsSecretAccessKey: {{ .Values.secrets.blobstorePassword }}
            resourcePool:
              connectionConfig:
                awsSecretAccessKey: {{ .Values.secrets.blobstorePassword }}
        ccUploader:
          certificateSecrets:
            ccClient: all-in-one-tls
            server: all-in-one-tls
        routeRegistrar:
          certificateSecret: all-in-one-tls
        ccdb:
          password: {{ .Values.secrets.dbPassword }}
          caCertificateSecret: all-in-one-tls
        oauthClientsSecret: {{ .Values.secrets.oauthClientsSecret }}

  - name: nfs-volume
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.nfsVolume.url }}
    version: {{ .Values.charts.nfsVolume.version }}
    installed: {{ .Values.installOptionalComponents }}
    timeout: 900
    needs:
      - capi
    values:
      - nfsbroker:
          enabled: true
          certificateSecret: all-in-one-tls
          oauthClientsSecret: {{ .Values.secrets.oauthClientsSecret }}
        nfsv3driver:
          enabled: true

  - name: cf-networking
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.cfNetworking.url }}
    version: {{ .Values.charts.cfNetworking.version }}
    installed: {{ .Values.installOptionalComponents }}
    needs:
      - capi
      - uaa
      - locket
      - loggregator-agent
    values:
      - policyServer:
          enabled: true
          systemDomain: {{ .Values.systemDomain }}
          networkpolicydb:
            password: {{ .Values.secrets.dbPassword }}
            caCertificateSecret: all-in-one-tls
            skipSSLVerify: false
          oauthClientsSecret: {{ .Values.secrets.oauthClientsSecret }}
          certificateSecret: all-in-one-tls
        serviceDiscoveryController:
          enabled: true
          certificateSecret: all-in-one-tls
        boshDnsAdapter:
          enabled: true
          certificateSecret: all-in-one-tls
        boshDns:
          certificateSecret: all-in-one-tls

  - name: policy-agent
    namespace: {{ .Values.systemNamespace }}
    chart: {{ .Values.charts.policyAgent.url }}
    version: {{ .Values.charts.policyAgent.version }}
    installed: {{ .Values.installOptionalComponents }}
    needs:
      - cf-networking
    values:
      - certificateSecret: all-in-one-tls
        pollInterval: "5s"
        cni: {{ .Values.cni }}
    hooks:
      - events: ["postsync"]
        showlogs: true
        command: "/bin/sh"
        args:
          - "-c"
          - |
            kubectl get configmap coredns -n kube-system -o jsonpath='{.data.Corefile}' | grep -q "apps.internal:53" || {
              echo "Patching CoreDNS to forward apps.internal to bosh-dns"
              BOSH_DNS_IP=$(kubectl get svc bosh-dns -n {{ .Values.systemNamespace }} -o jsonpath='{.spec.clusterIP}')
              COREFILE=$(kubectl get configmap coredns -n kube-system -o jsonpath='{.data.Corefile}')
              printf '%s\n\n%s' "apps.internal:53 {
                errors
                forward . ${BOSH_DNS_IP}
              }" "$COREFILE" | kubectl create configmap coredns -n kube-system --from-file=Corefile=/dev/stdin --dry-run=client -o yaml | kubectl apply -f -
              kubectl rollout restart deployment coredns -n kube-system
            }
